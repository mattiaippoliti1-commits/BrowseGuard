{
    "manifest_version": 3,

    "name": "BrowserGuard",

    "version": "1.0.0",

    "description": "Local Web Security, Privacy, Tracking, and Network Signal Monitor",

    "icons": {
        "16": "assets/icons/icon16.png",
        "32": "assets/icons/icon32.png",
        "48": "assets/icons/icon48.png",
        "128": "assets/icons/icon128.png"
    },

    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "assets/icons/icon16.png",
            "32": "assets/icons/icon32.png",
            "48": "assets/icons/icon48.png",
            "128": "assets/icons/icon128.png"
        }
    },

    "background": {
        "service_worker": "background/service-worker.js"
    },

    "permissions": [
        "tabs",
        "scripting",
        "storage",
        "webRequest"
    ],

    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "content/runtime-bridge.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "content/runtime-monitor.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "content/page-analysis.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
