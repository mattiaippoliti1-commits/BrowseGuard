{
    "manifest_version": 3,

    "name": "BrowserGuard",

    "version": "1.0",

    "description": "Real-Time Phishing and Web Risk Detection",

    "action": {
        "default_popup": "popup/popup.html"
    },

    "background": {
        "service_worker": "background/service-worker.js"
    },

    "permissions": [
        "tabs",
        "scripting",
        "storage",
        "webRequest"
    ],

    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "content/runtime-bridge.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "content/runtime-monitor.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "content/page-analysis.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
