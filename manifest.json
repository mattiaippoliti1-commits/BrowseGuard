{
    "manifest_version": 3,

    "name": "BrowserGuard",

    "version": "1.0",

    "description": "Real-Time Phishing and Web Risk Detection",

    "action": {
        "default_popup": "popup.html"
    },

    "permissions": [
        "tabs",
        "activeTab"
    ],

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}